{
  "name": "writer-agent",
  "version": "0.1.0",
  "description": "Local-first AI writing assistant. Multi-provider, offline-capable, token-efficient.",
  "type": "module",
  "bin": {
    "writer": "./dist/bin/writer.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch bin/writer.ts",
    "start": "node dist/bin/writer.js",
    "typecheck": "tsc --noEmit"
