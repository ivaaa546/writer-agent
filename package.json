  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@google/generative-ai": "^0.24.1",
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.11.1",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "inquirer": "^14.0.2",
    "keytar": "^7.9.0",
    "mammoth": "^1.12.0",
    "open": "^11.0.0",
    "openai": "^6.44.0",
    "ora": "^9.4.0",
    "pdf-parse": "^2.4.5",
    "tiktoken": "^1.0.22",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
